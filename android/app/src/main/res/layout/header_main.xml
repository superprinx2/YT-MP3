<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="16dp">

    <!-- Encabezado animado con logo -->
    <FrameLayout
        android:id="@+id/hero"
        android:layout_width="match_parent"
        android:layout_height="176dp"
        android:layout_marginTop="12dp"
        android:elevation="6dp"
        android:background="@drawable/bg_hero_shape"
        android:outlineProvider="background">

        <com.gabo.ytmp3.HeroView
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <ImageView
            android:id="@+id/logo"
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:layout_marginStart="18dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_logo"
            android:contentDescription="YT MP3"
            android:elevation="4dp"
            android:padding="10dp"
            android:src="@drawable/ic_logo_note" />

        <ImageButton
            android:id="@+id/btnSettings"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="end|top"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/bg_glass_circle"
            android:contentDescription="Ajustes"
            android:src="@drawable/ic_gear" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:gravity="bottom"
            android:orientation="horizontal"
            android:paddingStart="18dp"
            android:paddingEnd="14dp"
            android:paddingBottom="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_bold"
                    android:letterSpacing="-0.02"
                    android:shadowColor="#40000000"
                    android:shadowDy="2"
                    android:shadowRadius="6"
                    android:text="YT MP3"
                    android:textColor="#FFFFFF"
                    android:textSize="30sp" />

                <TextView
                    android:id="@+id/heroSubtitle"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Música y videos sin anuncios"
                    android:textColor="#E6FFFFFF"
                    android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/modeChip"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="@drawable/bg_glass"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_bolt" />

                <TextView
                    android:id="@+id/modeText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:fontFamily="@font/inter_semibold"
                    android:text="Rápido"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- Campo de búsqueda tipo iOS -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_field"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="4dp">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_link" />

        <EditText
            android:id="@+id/urlInput"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@null"
            android:hint="Pega el enlace del video o playlist"
            android:imeOptions="actionGo"
            android:importantForAutofill="no"
            android:inputType="textUri"
            android:maxLines="1"
            android:textColor="@color/ios_label"
            android:textColorHint="@color/ios_secondary"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/btnPaste"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="@drawable/bg_chip_blue"
            android:fontFamily="@font/inter_semibold"
            android:gravity="center"
            android:paddingHorizontal="14dp"
            android:text="Pegar"
            android:textColor="@color/btn_text_blue"
            android:textSize="15sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/urlError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:paddingStart="4dp"
        android:textColor="@color/ios_red"
        android:textSize="13sp"
        android:visibility="gone" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnAnalyze"
        style="@style/IosButton.Gray"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Buscar" />

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/analyzeSpinner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:indeterminate="true"
        android:visibility="gone"
        app:indicatorColor="@color/ios_blue"
        app:trackColor="@color/ios_track"
        app:trackCornerRadius="2dp"
        app:trackThickness="3dp" />

    <TextView
        android:id="@+id/infoText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:paddingHorizontal="4dp"
        android:text="También puedes tocar «Compartir» en la app de YouTube y elegir YT MP3."
        android:textColor="@color/ios_secondary"
        android:textSize="14sp" />

    <!-- Formato: control segmentado -->
    <TextView
        style="@style/IosSectionHeader"
        android:text="Formato" />

    <LinearLayout
        android:id="@+id/segment"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:background="@drawable/bg_segment"
        android:orientation="horizontal"
        android:padding="2dp">

        <TextView
            android:id="@+id/segMp3"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_segment_item"
            android:fontFamily="@font/inter_semibold"
            android:gravity="center"
            android:text="🎵  MP3 · Audio"
            android:textColor="@color/segment_text"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/segMp4"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_segment_item"
            android:fontFamily="@font/inter_semibold"
            android:gravity="center"
            android:text="🎬  MP4 · Video"
            android:textColor="@color/segment_text"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Opciones agrupadas (lista inset de iOS) -->
    <TextView
        style="@style/IosSectionHeader"
        android:text="Opciones" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_card"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/rowQuality"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@drawable/bg_row_top"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_quality" />

            <TextView
                style="@style/IosRowLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="Calidad" />

            <TextView
                android:id="@+id/qualityValue"
                style="@style/IosRowValue"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:gravity="end"
                android:maxLines="1" />

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginStart="8dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_chevron" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_marginStart="48dp"
            android:background="@color/ios_separator" />

        <LinearLayout
            android:id="@+id/rowFolder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_row_bottom"
            android:gravity="center_vertical"
            android:minHeight="50dp"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp"
            android:paddingVertical="8dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_folder" />

            <TextView
                style="@style/IosRowLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="Guardar en" />

            <TextView
                android:id="@+id/folderValue"
                style="@style/IosRowValue"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:ellipsize="start"
                android:gravity="end"
                android:maxLines="2"
                android:text="Elegir…"
                android:textSize="15sp" />

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginStart="8dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_chevron" />
        </LinearLayout>
    </LinearLayout>

    <!-- Cabecera de la lista de videos -->
    <LinearLayout
        android:id="@+id/listHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:layout_marginBottom="2dp"
        android:gravity="bottom"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/listTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:layout_weight="1"
            android:letterSpacing="0.02"
            android:paddingStart="16dp"
            android:textAllCaps="true"
            android:textColor="@color/ios_secondary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/btnSelectAll"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:paddingHorizontal="8dp"
            android:paddingVertical="6dp"
            android:text="Seleccionar todo"
            android:textColor="@color/btn_text_blue"
            android:textSize="15sp" />
    </LinearLayout>
</LinearLayout>

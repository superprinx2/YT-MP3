<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android" android:enterFadeDuration="150" android:exitFadeDuration="150">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:radius="7dp" />
            <solid android:color="@color/ios_segment_on" />
            <stroke android:width="0.5dp" android:color="#0F000000" />
        </shape>
    </item>
    <item><shape android:shape="rectangle"><solid android:color="@android:color/transparent" /></shape></item>
</selector>
